# --- Database (docker-compose.yml / application-*.yml 공용) ---
DB_USERNAME=bus
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 호스트에 노출할 MySQL 포트 (application-local.yml 기본값과 동일)
DB_PORT=58816

# --- Naver Cloud Platform Directions API ---
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# --- Docker image publishing (Jib 작업을 실행할 때만 필요) ---
DOCKERHUB_USERNAME=
DOCKERHUB_PASSWORD=
